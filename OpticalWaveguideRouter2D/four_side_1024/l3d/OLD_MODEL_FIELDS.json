 "field_impact": {
  "layers_z_mm": {
   "old": "top-level array [0, 0.125, 0.25, 0.375, 0.5]; z2 row height 0.5 was layer index 4",
   "new": "replaced by layer_stack object (L1 interface_rows 0/0.5 + L2..L5 unconfirmed physical heights + provenance); the old array must not be accepted"
  },
  "interface_layer_numeric": {
   "old": "0 for z1 routes, 4 for z2 routes",
   "new": "logical interface layer is ALWAYS 1 for both rows; row height comes from the port row, not from the layer index"
  },
  "interface_z_mm": {
   "old": "0.0 for z1, 0.5 for z2",
   "new": "same physical meaning (row height) but must be attached to L1 layer_id 1; new JSON uses start_z_mm/end_z_mm and source_port.z_mm/target_port.z_mm"
  },
  "flat_part_layer": {
   "old": "logical index 0..4 that also encoded the physical height",
   "new": "renamed layer_id; 0.0/0.5 become row heights of layer_id 1, so old indices 0 and 4 both map to 1 and old indices 1..3 have no counterpart"
  },
  "flat_part_z_mm": {
   "old": "one of the old stack values [0, 0.125, 0.25, 0.375, 0.5]",
   "new": "physical height; 0.0/0.5 allowed on L1 by row; other heights must equal the (unconfirmed) L2..L5 heights"
  },
  "travel_layer": {
   "old": "1..3 (layer index inside the squeezed 0-0.5 mm domain), null for flat routes",
   "new": "no single travel layer: replace by layer_sequence[1:-1] / layers_used with ids 2..5; old ids 1..3 are not valid layer ids of the new model"
  },
  "travel_z_mm": {
   "old": "0.125/0.25/0.375 (old intermediate heights)",
   "new": "no single travel z: layer_z_sequence carries the real physical height of every visited layer (L2..L5 unconfirmed, e.g. 1.0/1.5/2.0/2.5)"
  },
  "n_transitions": {
   "old": "0 or 2 (flat, or up+down)",
   "new": "any number; layer_sequence length = n_transitions + 1; multi-transition and direct non-adjacent transitions allowed"
  },
  "mode": {
   "old": "\"flat\" or \"lifted\" (binary)",
   "new": "layer_sequence/lifted replace it; a route may visit several routing layers"
  },
  "z_span_mm": {
   "old": "|travel_z - interface_z| of the single travel layer",
   "new": "max(layer_z_sequence) - min(layer_z_sequence)"
  },
  "transition_part": {
   "old": "keys start/end/direction/z0_mm/z1_mm/dz_mm/radius_mm/footprint_mm/length_mm",
   "new": "keys start/end/direction/from_layer/to_layer/z0/z1/dz_mm/radius_mm/theta_rad/footprint_mm/length_mm; transition may connect any pair of distinct layers"
  },
  "route_base_fields": {
   "old": "internal build_route3d output has base_layer/base_z_mm but the delivered JSON drops them and writes interface_layer/interface_z_mm instead",
   "new": "interface is always layer_id 1; the row height must be carried explicitly (port.z_mm / start_z_mm / end_z_mm)"
  },
  "route_port": {
   "old": "port {p, q, start_tangent, end_tangent} (no z/layer)",
   "new": "source_port / target_port with xy, z_mm, layer_id; start_z_mm/end_z_mm at route level"
  },
  "failure_reason": {
   "old": "\"no_2d_candidate\" | \"no_lift_candidate\" (old lift search)",
   "new": "failure taxonomy of the new search (e.g. no L1 candidate, no legal layer-sequence); old \"lift\" notion is obsolete"
  }
 },
